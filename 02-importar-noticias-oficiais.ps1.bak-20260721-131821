$ErrorActionPreference = "Stop"

function ConvertFrom-HtmlText([string]$html) {
  $text = [regex]::Replace($html, '<script[\s\S]*?</script>', ' ', 'IgnoreCase')
  $text = [regex]::Replace($text, '<style[\s\S]*?</style>', ' ', 'IgnoreCase')
  $text = [regex]::Replace($text, '<[^>]+>', ' ')
  $text = [System.Net.WebUtility]::HtmlDecode($text)
  return ([regex]::Replace($text, '\s+', ' ')).Trim()
}

function Resolve-OfficialImage([string]$url, [string]$html) {
  $patterns = @(
    '<meta[^>]+property=["'']og:image["''][^>]+content=["'']([^"'']+)["'']',
    '<meta[^>]+content=["'']([^"'']+)["''][^>]+property=["'']og:image["'']',
    '<img[^>]+src=["'']([^"'']+)["'']'
  )

  $candidates = @()
  foreach ($pattern in $patterns) {
    foreach ($match in [regex]::Matches($html, $pattern, 'IgnoreCase')) {
      $candidates += $match.Groups[1].Value
    }
  }

  $base = [Uri]$url
  foreach ($candidate in $candidates) {
    if ($candidate -match '(?i)(logo|banner|icone|icon|spacer|loading|processando)') { continue }
    try {
      $absolute = [Uri]::new($base, $candidate).AbsoluteUri
      if ($absolute -match '(?i)\.(jpg|jpeg|png|webp)(\?|$)') {
        return $absolute
      }
    } catch {}
  }

  return $null
}

function Escape-Sql([string]$value) {
  if ($null -eq $value) { return $null }
  return $value.Replace("'", "''")
}

