foreach ($article in $articles) {
  Write-Host "Consultando imagem oficial: $($article.Title)" -ForegroundColor Cyan
    try {
    $response = Invoke-WebRequest `
      -Uri $article.SourceUrl `
      -UseBasicParsing `
      -TimeoutSec 45
  }
  catch {
    $uri = [Uri]$article.SourceUrl

    if ($uri.Host -notin @('www.ceasaminas.com.br', 'ceasaminas.com.br')) {
      throw
    }

    Write-Warning "O certificado HTTPS do site oficial está inválido ou fora da validade. Tentando novamente somente para o domínio oficial da CeasaMinas."

    $response = Invoke-WebRequest `
      -Uri $article.SourceUrl `
      -UseBasicParsing `
      -TimeoutSec 45 `
      -SkipCertificateCheck
  }
  $article.ImageUrl = Resolve-OfficialImage $article.SourceUrl $response.Content

  if (-not $article.ImageUrl) {
    throw "Nenhuma imagem oficial foi encontrada em $($article.SourceUrl). A importação foi interrompida para não usar imagem incorreta."
  }

  Write-Host "Imagem localizada: $($article.ImageUrl)" -ForegroundColor DarkGreen
}

$sqlParts = @()
foreach ($article in $articles) {
  $id = Escape-Sql $article.Id
  $title = Escape-Sql $article.Title
  $slug = Escape-Sql $article.Slug
  $summary = Escape-Sql $article.Summary
  $content = Escape-Sql $article.Content
  $imageUrl = Escape-Sql $article.ImageUrl
  $sourceUrl = Escape-Sql $article.SourceUrl
  $publishedAt = Escape-Sql $article.PublishedAt

  $sqlParts += @"
INSERT INTO news_articles
  (id, title, slug, category, summary, content, "imageUrl", "sourceUrl", status, "publishedAt", "createdAt", "updatedAt")
VALUES
  ('$id', '$title', '$slug', 'Institucional', '$summary', '$content', '$imageUrl', '$sourceUrl', 'PUBLISHED', '$publishedAt'::timestamptz, NOW(), NOW())
ON CONFLICT (slug) DO UPDATE SET
  title = EXCLUDED.title,
  category = EXCLUDED.category,
  summary = EXCLUDED.summary,
  content = EXCLUDED.content,
  "imageUrl" = EXCLUDED."imageUrl",
  "sourceUrl" = EXCLUDED."sourceUrl",
  status = EXCLUDED.status,
  "publishedAt" = EXCLUDED."publishedAt",
  "updatedAt" = NOW();
"@
}

$sql = $sqlParts -join "`n"

