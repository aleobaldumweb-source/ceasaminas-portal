# PostgreSQL
POSTGRES_DB=ceasaminas
POSTGRES_USER=ceasaminas
POSTGRES_PASSWORD=ceasaminas_dev
DATABASE_URL=postgresql://ceasaminas:ceasaminas_dev@localhost:5432/ceasaminas?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3333
API_PREFIX=api/v1
API_PUBLIC_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:3333
NEXT_PUBLIC_PORTAL_ORIGIN=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ceasaminas.local
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Active Directory (opcional)
AD_ENABLED=false
AD_URL=ldaps://ad.exemplo.local:636
AD_BIND_DN=CN=svc-ceasaminas,OU=Servicos,DC=exemplo,DC=local
# AD_BIND_PASSWORD=
AD_BASE_DN=DC=exemplo,DC=local
AD_USER_FILTER=(userPrincipalName={email})
AD_ADMIN_GROUP=CN=Ceasaminas Portal Admins,OU=Grupos,DC=exemplo,DC=local
AD_EDITOR_GROUP=CN=Ceasaminas Portal Editores,OU=Grupos,DC=exemplo,DC=local
AD_JOURNALIST_GROUP=CN=Ceasaminas Portal Jornalistas,OU=Grupos,DC=exemplo,DC=local
AD_AUDITOR_GROUP=CN=Ceasaminas Portal Auditores,OU=Grupos,DC=exemplo,DC=local
AD_TIMEOUT_MS=5000

# MinIO
MINIO_ROOT_USER=ceasaminas
MINIO_ROOT_PASSWORD=ceasaminas_minio_dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ceasaminas
