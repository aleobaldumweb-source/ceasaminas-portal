[Unit]
Description=Backup da plataforma Ceasaminas
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ceasaminas/backup.conf
ExecStart=/usr/bin/bash ${PROJECT_DIR}/scripts/backup-production.sh ${BACKUP_DIR} ${RETENTION_DAYS} --env-file ${ENV_FILE}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
