PORTAL_DOMAIN=www.exemplo.ceasaminas.com.br
ADMIN_DOMAIN=admin.exemplo.ceasaminas.com.br
API_DOMAIN=api.exemplo.ceasaminas.com.br
POSTGRES_DB=ceasaminas
POSTGRES_USER=ceasaminas
POSTGRES_PASSWORD=substitua-por-um-segredo-forte
JWT_ACCESS_SECRET=substitua-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_REFRESH_SECRET=substitua-por-outro-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BOOTSTRAP_ADMIN_TOKEN=substitua-por-um-token-de-instalacao-aleatorio
SMTP_HOST=smtp.exemplo.ceasaminas.com.br
SMTP_PORT=587
SMTP_FROM=no-reply@ceasaminas.com.br
SMTP_SECURE=false
SMTP_USER=substitua-pelo-usuario-smtp
SMTP_PASSWORD=substitua-pela-senha-smtp
AD_ENABLED=false
AD_URL=ldaps://ad.exemplo.local:636
AD_BIND_DN=CN=svc-ceasaminas,OU=Servicos,DC=exemplo,DC=local
AD_BIND_PASSWORD=substitua-pela-senha-da-conta-de-servico
AD_BASE_DN=DC=exemplo,DC=local
AD_USER_FILTER=(userPrincipalName={email})
AD_ADMIN_GROUP=CN=Ceasaminas Portal Admins,OU=Grupos,DC=exemplo,DC=local
AD_EDITOR_GROUP=CN=Ceasaminas Portal Editores,OU=Grupos,DC=exemplo,DC=local
AD_JOURNALIST_GROUP=CN=Ceasaminas Portal Jornalistas,OU=Grupos,DC=exemplo,DC=local
AD_AUDITOR_GROUP=CN=Ceasaminas Portal Auditores,OU=Grupos,DC=exemplo,DC=local
AD_TIMEOUT_MS=5000
